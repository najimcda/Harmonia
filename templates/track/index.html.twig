{% extends 'base.html.twig' %}

{% block title %}Toutes les musiques{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Musiques</h1>
    <a href="{{ path('app_track_item') }}" class="btn btn-primary mb-3">+ Ajouter une musique</a>

    <div class="row">
        {% for track in tracks %}
            <div class="col-6 col-md-3 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">{{ track.name }}</h5>
                        <p><strong>Créée le : </strong> {{ track.createdAt|date('d/m/Y') }}</p>
                        <p><strong>Durée : </strong> {{ track.duration }}</p>
                        <p><strong>Album : </strong> {{ track.album.titre }}</p>
                        <p><strong>Genres : </strong>
                            {% for genre in track.genres %}
                                <span class="badge bg-secondary">{{ genre.name }}</span>
                            {% endfor %}
                        </p>

                        {% if app.user %}
                            
                            {% set isFav = false %}
                            {% for fav in app.user.favorite %}
                                {% if fav.track.id == track.id %}
                                    {% set isFav = true %}
                                {% endif %}
                            {% endfor %}

                            
                            <div class="d-flex gap-2 align-items-center">
                                <form action="{{ path('app_favorite', {id: track.id}) }}" method="POST" class="d-inline">
                                    {% if isFav %}
                                        <button type="submit" class="btn btn-danger btn-sm">
                                            Retirer des favoris
                                        </button>
                                    {% else %}
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            Ajouter aux favoris
                                        </button>
                                    {% endif %}
                                </form>

                                <a href="{{ path('app_history', {id: track.id}) }}" class="btn btn-outline-primary btn-sm">Écouter</a>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
    <a href="{{ path('app_home') }}" class="btn btn-secondary mb-3">Retour</a>
</div>
{% endblock %}