{% extends 'base.html.twig' %}

{% block title %}{{ artist.name }}{% endblock %}

{% block body %}
<div class="container mt-4">
    <a href="{{ path('app_artist') }}" class="btn btn-secondary mb-3">Retour</a>
<a href="{{ path('app_artist_edit', {id: artist.id}) }}" class="btn btn-primary mb-3">Modifier</a>
<a href="{{ path('app_album_item', {artist_id: artist.id}) }}" class="btn btn-success mb-3">+ Ajouter un album</a>

    <h1>{{ artist.name }}</h1>
    <span class="badge bg-secondary mb-3">{{ artist.type }}</span>

    <p><strong>Nom de scène :</strong> {{ artist.sceneName }}</p>
    <p><strong>Pays d'origine :</strong> {{ artist.originCountry }}</p>
    <p><strong>Biographie :</strong> {{ artist.biography }}</p>
    <p><strong>Sur Harmonia depuis :</strong> {{ artist.createdAt|date('d/m/Y') }}</p>

    <h2 class="mt-4">Albums</h2>
    <div class="row">
        {% for album in artist.albums %}
            <div class="col-6 col-md-3 mb-3">
                <a href="{{ path('app_album_show', {id: album.id}) }}" class="d-block text-decoration-none text-dark">
                    <div class="card">
                        <img src="{{ asset(album.jacket) }}" class="card-img-top" style="width:100%; height:200px; object-fit:cover;">
                        <div class="card-body">
                            <h5 class="card-title">{{ album.titre }}</h5>
                        </div>
                    </div>
                </a>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}