{% extends 'base.html.twig' %}

{% block title %}Artistes{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Artistes</h1>
        <a href="{{ path('app_artist_item') }}" class="btn btn-primary">+ Ajouter un artiste</a>
    </div>

    <div class="row">
        {% for artist in artists %}
            <div class="col-6 col-md-3 mb-3 d-flex">
                <a href="{{ path('app_artist_show', {id: artist.id}) }}" class="d-block text-decoration-none text-dark w-100">
                    <div class="card h-100">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">{{ artist.name }}</h5>
                            <p class="card-text">{{ artist.biography|slice(0, 100) }}...</p>
                            <span class="badge bg-secondary mt-auto align-self-start">{{ artist.type }}</span>
                        </div>
                    </div>
                </a>
            </div>
        {% endfor %}
    </div>
    <a href="{{ path('app_home') }}" class="btn btn-secondary mb-3">Retour</a>
</div>
{% endblock %}