{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<nav class="navbar navbar-expand-lg bg-body-tertiary">
  <div class="container-fluid">
    <a class="navbar-brand" href="#">Harmonia</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav">
    <li class="nav-item">
        <a class="nav-link active" aria-current="page" href="#">Albums</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="{{ path('app_track') }}">Musiques</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="{{ path('app_artist') }}">Artistes</a>
    </li>

    {% if app.user %}
        <li class="nav-item">
            <a class="nav-link" href="{{ path('app_profile') }}">Profil</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="{{ path('app_logout') }}">Se déconnecter</a>
        </li>
    {% else %}
        <li class="nav-item">
            <a class="nav-link" href="{{ path('app_login') }}">Se connecter</a>
        </li>
    {% endif %}
</ul>
    </div>
  </div>
</nav>

<h2 class="mt-4">Albums</h2>
<div class="row">
    {% for album in albums %}
        <div class="col-6 col-md-3 mb-3">
            {% include 'Component/albumCard.html.twig' with {album:album }%}
        </div>
    {% endfor %}
</div>

<h2 class="mt-4">Eps</h2>
<div class="row">
    {% for ep in eps %}
        <div class="col-6 col-md-3 mb-3">
            {% include 'Component/albumCard.html.twig' with {album:ep}%}
        </div>
    {% endfor %}
</div>

<h2 class="mt-4">Singles</h2>
<div class="row">
    {% for single in singles %}
        <div class="col-6 col-md-3 mb-3">
            {% include 'Component/albumCard.html.twig' with {album:single}%}
        </div>
    {% endfor %}
</div>

{% endblock %}